{
  "name": "aprova-univesp",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "node --use-system-ca node_modules/next/dist/bin/next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/unit/*.test.cjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:admin": "node scripts/admin.mjs",
    "db:cleanup": "node scripts/cleanup.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore:verify": "node scripts/verify-backup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "db:test:setup": "node scripts/test-setup.mjs",
    "test:server": "node scripts/test-server.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "postinstall": "node scripts/harden-dependencies.mjs",
    "test:browser": "node scripts/test-setup.mjs && playwright test",
    "test:load": "node scripts/load-check.mjs",
    "ops:monitor": "node scripts/monitor.mjs",
    "security:check": "node scripts/security-check.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.95",
    "@ai-sdk/groq": "^4.0.60",
    "@vercel/functions": "^3.9.10",
    "ai": "^7.0.139",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "^16.4.0",
    "otpauth": "^9.5.2",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "source-map-js": "^1.2.2"
  }
}
