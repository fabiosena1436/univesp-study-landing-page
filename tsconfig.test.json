{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false,
    "rootDir": "./src",
    "outDir": "./.test-build",
    "plugins": []
  },
  "include": [
    "src/lib/tutorQuotaPolicy.ts",
    "src/lib/tutorScope.ts",
    "src/lib/tutorPlatform.ts",
    "src/lib/validation.ts",
    "src/lib/ai.ts",
    "src/lib/passwordReset.ts",
    "src/lib/sample.ts",
    "src/lib/constants.ts",
    "src/lib/api.ts",
    "src/lib/access.ts",
    "src/lib/mfa.ts",
    "src/lib/pdfValidation.ts",
    "src/lib/clientRateLimit.ts"
  ],
  "exclude": [
    "node_modules",
    ".test-build"
  ]
}
