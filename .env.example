DATABASE_URL=postgresql://app:app@localhost:55432/app_db
# Neon: use -pooler in DATABASE_URL; paste the direct connection below for migrations/backups.
DATABASE_URL_UNPOOLED=
# Without Gemini, only existing structured questions are extracted; new questions are not generated.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Student tutor uses Groq independently of Gemini question generation.
GROQ_API_KEY=
GROQ_TUTOR_MODEL=openai/gpt-oss-120b
# Search is disabled by default. Enabling it may require paid Gemini access.
GEMINI_GOOGLE_SEARCH=false
# Resend is required for password recovery; registration does not send confirmation.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aprova UNIVESP <noreply@seu-dominio-verificado.com>
APP_URL=http://localhost:3000
DB_POOL_MAX=10
# Use UTC in the Node process; user-facing study dates use America/Sao_Paulo.
TZ=UTC

# A stable secret key is required before enabling MFA. Generate 32 random bytes as hex.
MFA_ENCRYPTION_KEY=
MFA_REQUIRE_ADMIN=false
# Trust forwarded client IPs only behind a proxy that overwrites these headers.
TRUST_PROXY=false
# Conservative reserved token budgets, not monetary billing estimates.
AI_USER_DAILY_TOKEN_BUDGET=500000
AI_MONTHLY_TOKEN_BUDGET=5000000
AI_TUTOR_DAILY_MESSAGES=20
# App budgets, not the provider's remaining quota. UTC calendar day; adjust to your Groq account limits.
AI_TUTOR_USER_DAILY_TOKENS=20000
AI_TUTOR_SHARED_DAILY_TOKENS=180000
AI_TUTOR_SHARED_DAILY_MESSAGES=900
API_SLOW_MS=2000
MONITOR_URL=
